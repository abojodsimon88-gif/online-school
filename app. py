@app.route("/login", methods=["GET", "POST"])
def login():
    error = ""
    if request.method == "POST":
        selected_user_key = (request.form.get("user_key") or "").strip()
        password = request.form.get("password") or ""

        with get_db() as conn:
            user = conn.execute(
                "SELECT user_key, name, role, password FROM users WHERE user_key = ?",
                (selected_user_key,),
            ).fetchone()

        if user and user["password"] == password:
            session.clear()
            session["user_key"] = user["user_key"]
            session["username"] = user["name"]
            session["role"] = user["role"]
            return redirect(url_for("dashboard"))
        error = "اسم الحساب أو كلمة المرور غير صحيحة."

    with get_db() as conn:
        users = conn.execute(
            "SELECT user_key, name, role FROM users ORDER BY name"
        ).fetchall()

    admin_keys = {"khader", "bretta", "fouad"}
    male_keys = {"nizar", "mike", "ahmad", "saba", "anders", "waleed"}
    groups = {"admin": [], "male": [], "female": []}

    for user in users:
        key = user["user_key"]
        option = (
            f'<option value="{escape(key, quote=True)}">'
            f'{escape(user["role"])}: {escape(user["name"])}</option>'
        )
        if key in admin_keys:
            groups["admin"].append(option)
        elif key in male_keys:
            groups["male"].append(option)
        else:
            groups["female"].append(option)

    content = f"""
    <section class="panel" style="max-width:420px;margin:40px auto;">
      <h2>تسجيل الدخول - منصة المدرسة الإلكترونية</h2>
      {f'<p class="message" style="color:#b00020">{escape(error)}</p>' if error else ''}
      <form method="post">
        <label>اختر الاسم والدور</label>
        <select name="user_key" required>
          <option value="" disabled selected>-- اختر الحساب --</option>
          <optgroup label="الإدارة والكادر الإشرافي">{''.join(groups['admin'])}</optgroup>
          <optgroup label="المعلمون">{''.join(groups['male'])}</optgroup>
          <optgroup label="المعلمات">{''.join(groups['female'])}</optgroup>
        </select>
        <label>كلمة المرور</label>
        <input type="password" name="password" required autocomplete="current-password">
        <button type="submit" style="width:100%">دخول إلى المنصة</button>
      </form>
    </section>"""
    return page(content, "تسجيل الدخول - المنصة المدرسية")


