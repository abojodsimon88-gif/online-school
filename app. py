@app.route("/change_password", methods=["GET", "POST"])
def change_password():
    if not logged_in():
        return redirect(url_for("login"))

    message = ""
    message_class = "message"

    if request.method == "POST":
        old_pass = request.form.get("old_pass") or ""
        new_pass = request.form.get("new_pass") or ""

        if not new_pass.strip():
            message = "كلمة المرور الجديدة لا يمكن أن تكون فارغة."
        else:
            with get_db() as conn:
                user = conn.execute(
                    "SELECT password FROM users WHERE user_key = ?",
                    (session["user_key"],),
                ).fetchone()

                if user and user["password"] == old_pass:
                    conn.execute(
                        "UPDATE users SET password = ? WHERE user_key = ?",
                        (new_pass, session["user_key"]),
                    )
                    message = "تم تغيير كلمة المرور بنجاح."
                    message_class = "message"
                else:
                    message = "كلمة المرور القديمة غير صحيحة."
                    message_class = "message"

    content = f"""
    <section class="panel" style="max-width:420px;margin:40px auto;">
      <h2>تغيير كلمة المرور</h2>
      {f'<p class="{message_class}">{escape(message)}</p>' if message else ''}
      <form method="post">
        <label>كلمة المرور القديمة</label>
        <input type="password" name="old_pass" required autocomplete="current-password">
        <label>كلمة المرور الجديدة</label>
        <input type="password" name="new_pass" required autocomplete="new-password">
        <button class="success" type="submit" style="width:100%">حفظ التغيير</button>
      </form>
      <p><a href="{url_for('dashboard')}">العودة إلى لوحة التحكم</a></p>
    </section>"""
    return page(content, "تغيير كلمة المرور")


